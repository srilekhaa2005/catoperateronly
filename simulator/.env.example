# Base URL of the FastAPI backend (Member 1). Must include /api per API_CONTRACT.md.
BACKEND_URL=http://localhost:8000/api

# Port this simulator's own control API (POST /simulator/scenario) listens on.
SIMULATOR_PORT=8100

# RNG seed — keep fixed for a reproducible demo run; change to get a different
# (still deterministic) run.
SIM_SEED=42
